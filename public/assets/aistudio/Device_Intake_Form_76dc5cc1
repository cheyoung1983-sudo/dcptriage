import React, { useState } from 'react';
import { 
 User, 
 Smartphone, 
 Activity, 
 ShieldCheck, 
 Save, 
 Cpu, 
 Thermometer, 
 Database,
 CheckCircle2,
 AlertTriangle
} from 'lucide-react';

export default function App() {
 const [isSubmitting, setIsSubmitting] = useState(false);
 const [isSuccess, setIsSuccess] = useState(false);
 
 const [formData, setFormData] = useState({
   // Client Details
   firstName: '',
   lastName: '',
   email: '',
   phone: '',
   
   // Device Manifest
   manufacturer: '',
   model: '',
   identifier: '', // IMEI or Serial
   passcode: '',
   
   // Fault Telemetry
   primaryFault: '',
   symptoms: [],
   technicianNotes: '',
   
   // Operations & Compliance
   locationCode: '3202', // Default to Spokane
   syncShopify: true,
   draftOrder: true,
   dataDestructionConsent: false
 });

 const handleInputChange = (e) => {
   const { name, value, type, checked } = e.target;
   if (type === 'checkbox') {
     if (name === 'symptoms') {
       const updatedSymptoms = checked 
         ? [...formData.symptoms, value]
         : formData.symptoms.filter(s => s !== value);
       setFormData({ ...formData, symptoms: updatedSymptoms });
     } else {
       setFormData({ ...formData, [name]: checked });
     }
   } else {
     setFormData({ ...formData, [name]: value });
   }
 };

 const handleSubmit = (e) => {
   e.preventDefault();
   setIsSubmitting(true);
   
   // Simulate API call to backend / Vercel Edge / Postgres
   setTimeout(() => {
     setIsSubmitting(false);
     setIsSuccess(true);
     
     // Reset form after 3 seconds
     setTimeout(() => {
       setIsSuccess(false);
       setFormData({
         ...formData,
         firstName: '', lastName: '', email: '', phone: '',
         manufacturer: '', model: '', identifier: '', passcode: '',
         primaryFault: '', symptoms: [], technicianNotes: '',
         dataDestructionConsent: false
       });
     }, 3000);
   }, 1500);
 };

 const faultOptions = [
   { id: 'no-power', label: 'No Power / VDD_MAIN Short' },
   { id: 'liquid', label: 'Liquid Immersion Damage' },
   { id: 'display', label: 'Display / Digitizer Failure' },
   { id: 'battery', label: 'Battery Degradation' },
   { id: 'boot-loop', label: 'Kernel Panic / Boot Loop' },
   { id: 'data', label: 'Data Extraction Protocol' },
 ];

 return (
   <div className="min-h-screen bg-slate-950 text-slate-300 font-sans p-4 md:p-8">
     <div className="max-w-5xl mx-auto">
       
       {/* Header */}
       <div className="mb-8 border-b border-slate-800 pb-6 flex items-center justify-between">
         <div>
           <h1 className="text-3xl font-bold text-white flex items-center gap-3">
             <Cpu className="text-blue-500" size={32} />
             Hardware Triage Intake
           </h1>
           <p className="text-slate-400 mt-2 text-sm">
             D&CP LLC Operations Hub • Secure Diagnostic Entry Protocol
           </p>
         </div>
         <div className="hidden md:flex items-center gap-2 bg-slate-900 border border-slate-800 px-4 py-2 rounded-lg">
           <div className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
           <span className="text-xs text-slate-400 font-mono tracking-wider">SYSTEM SECURE</span>
         </div>
       </div>

       {isSuccess ? (
         <div className="bg-emerald-900/20 border border-emerald-500/50 rounded-xl p-12 text-center flex flex-col items-center justify-center animate-in fade-in zoom-in duration-300">
           <CheckCircle2 className="text-emerald-400 mb-4 h-16 w-16" />
           <h2 className="text-2xl font-bold text-emerald-300 mb-2">Protocol Initiated</h2>
           <p className="text-emerald-400/80">Device manifest recorded to Vercel KV and synchronized with Shopify Metafields.</p>
         </div>
       ) : (
         <form onSubmit={handleSubmit} className="space-y-6">
           <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
             
             {/* Left Column: Client & Operations */}
             <div className="space-y-6 lg:col-span-1">
               {/* Client Details Card */}
               <div className="bg-slate-900/50 border border-slate-800 rounded-xl p-5 backdrop-blur-sm">
                 <h2 className="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                   <User className="text-blue-400" size={18} />
                   Client Profile
                 </h2>
                 <div className="space-y-4">
                   <div className="grid grid-cols-2 gap-3">
                     <div>
                       <label className="block text-xs font-medium text-slate-500 mb-1">First Name</label>
                       <input required type="text" name="firstName" value={formData.firstName} onChange={handleInputChange} className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                     </div>
                     <div>
                       <label className="block text-xs font-medium text-slate-500 mb-1">Last Name</label>
                       <input required type="text" name="lastName" value={formData.lastName} onChange={handleInputChange} className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                     </div>
                   </div>
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">Email Address</label>
                     <input required type="email" name="email" value={formData.email} onChange={handleInputChange} className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                   </div>
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">Phone Number</label>
                     <input required type="tel" name="phone" value={formData.phone} onChange={handleInputChange} className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                   </div>
                 </div>
               </div>

               {/* Statutory Compliance Card */}
               <div className="bg-slate-900/50 border border-slate-800 rounded-xl p-5 backdrop-blur-sm">
                 <h2 className="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                   <ShieldCheck className="text-purple-400" size={18} />
                   Operations & Compliance
                 </h2>
                 <div className="space-y-4">
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">WA Dept of Revenue Location</label>
                     <select name="locationCode" value={formData.locationCode} onChange={handleInputChange} className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 text-slate-300">
                       <option value="3202">3202 - Spokane (City)</option>
                       <option value="3213">3213 - Spokane Valley</option>
                     </select>
                   </div>
                   
                   <div className="pt-2 space-y-3">
                     <label className="flex items-center gap-3 cursor-pointer group">
                       <div className="relative">
                         <input type="checkbox" name="syncShopify" checked={formData.syncShopify} onChange={handleInputChange} className="sr-only" />
                         <div className={`block w-10 h-6 rounded-full transition-colors ${formData.syncShopify ? 'bg-blue-600' : 'bg-slate-800'}`}></div>
                         <div className={`absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform ${formData.syncShopify ? 'transform translate-x-4' : ''}`}></div>
                       </div>
                       <span className="text-xs text-slate-400 group-hover:text-slate-300 transition-colors">Sync to Shopify Metafields</span>
                     </label>

                     <label className="flex items-center gap-3 cursor-pointer group">
                       <div className="relative">
                         <input type="checkbox" name="draftOrder" checked={formData.draftOrder} onChange={handleInputChange} className="sr-only" />
                         <div className={`block w-10 h-6 rounded-full transition-colors ${formData.draftOrder ? 'bg-blue-600' : 'bg-slate-800'}`}></div>
                         <div className={`absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform ${formData.draftOrder ? 'transform translate-x-4' : ''}`}></div>
                       </div>
                       <span className="text-xs text-slate-400 group-hover:text-slate-300 transition-colors">Generate POS DraftOrder</span>
                     </label>
                   </div>
                 </div>
               </div>
             </div>

             {/* Right Column: Device & Telemetry */}
             <div className="space-y-6 lg:col-span-2">
               {/* Device Manifest Card */}
               <div className="bg-slate-900/50 border border-slate-800 rounded-xl p-5 backdrop-blur-sm relative overflow-hidden">
                 {/* Decorative circuit accent */}
                 <div className="absolute top-0 right-0 w-32 h-32 bg-blue-500/5 rounded-full blur-3xl"></div>
                 
                 <h2 className="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                   <Smartphone className="text-blue-400" size={18} />
                   Device Manifest
                 </h2>
                 <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">Manufacturer</label>
                     <select required name="manufacturer" value={formData.manufacturer} onChange={handleInputChange} className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 text-slate-300">
                       <option value="" disabled>Select Brand...</option>
                       <option value="Apple">Apple</option>
                       <option value="Samsung">Samsung</option>
                       <option value="Google">Google</option>
                       <option value="Other">Other / Custom</option>
                     </select>
                   </div>
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">Hardware Model (e.g., A2849)</label>
                     <input required type="text" name="model" value={formData.model} onChange={handleInputChange} placeholder="iPhone 15 Pro Max" className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                   </div>
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">Serial Number / IMEI</label>
                     <input required type="text" name="identifier" value={formData.identifier} onChange={handleInputChange} className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" />
                   </div>
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">Passcode / PIN (Optional)</label>
                     <input type="text" name="passcode" value={formData.passcode} onChange={handleInputChange} placeholder="Leave blank if unknown" className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors font-mono tracking-widest" />
                   </div>
                 </div>
               </div>

               {/* Fault Telemetry Card */}
               <div className="bg-slate-900/50 border border-slate-800 rounded-xl p-5 backdrop-blur-sm relative overflow-hidden">
                 <div className="absolute top-0 right-0 w-32 h-32 bg-rose-500/5 rounded-full blur-3xl"></div>

                 <h2 className="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                   <Activity className="text-rose-400" size={18} />
                   Reported Faults & Telemetry
                 </h2>
                 
                 <div className="space-y-5">
                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-2">Diagnostic Classification (Tier 1-3)</label>
                     <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                       {faultOptions.map(option => (
                         <label key={option.id} className="flex items-start gap-3 p-3 rounded-lg border border-slate-800 bg-slate-950/50 cursor-pointer hover:border-slate-700 hover:bg-slate-900 transition-all">
                           <input 
                             type="checkbox" 
                             name="symptoms" 
                             value={option.id} 
                             checked={formData.symptoms.includes(option.id)}
                             onChange={handleInputChange}
                             className="mt-0.5 rounded bg-slate-900 border-slate-700 text-blue-500 focus:ring-blue-500" 
                           />
                           <span className="text-sm text-slate-300">{option.label}</span>
                         </label>
                       ))}
                     </div>
                   </div>

                   <div>
                     <label className="block text-xs font-medium text-slate-500 mb-1">Initial Technician Observations</label>
                     <textarea 
                       name="technicianNotes" 
                       value={formData.technicianNotes} 
                       onChange={handleInputChange} 
                       rows="3" 
                       placeholder="E.g., Device pulls 5V 0.02A on ammeter. Suspect PMIC failure."
                       className="w-full bg-slate-950 border border-slate-800 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors resize-none placeholder-slate-700" 
                     />
                   </div>
                 </div>
               </div>
               
               {/* Authorization & Submit */}
               <div className="bg-slate-900 border border-rose-900/30 rounded-xl p-5">
                 <label className="flex items-start gap-3 cursor-pointer group mb-6">
                   <input required type="checkbox" name="dataDestructionConsent" checked={formData.dataDestructionConsent} onChange={handleInputChange} className="mt-1 rounded bg-slate-900 border-rose-900/50 text-rose-500 focus:ring-rose-500" />
                   <div>
                     <p className="text-sm text-slate-300 font-medium flex items-center gap-2">
                       NIST SP 800-88 Data Policy Acknowledgment
                       <AlertTriangle size={14} className="text-amber-500" />
                     </p>
                     <p className="text-xs text-slate-500 mt-1">I authorize D&CP LLC to perform micro-soldering diagnostics. I understand that Tier 3 board repair carries inherent risks of permanent data loss if NAND flash integrity is compromised.</p>
                   </div>
                 </label>

                 <div className="flex justify-end gap-3">
                   <button type="button" className="px-5 py-2.5 text-sm font-medium text-slate-400 hover:text-white transition-colors">
                     Cancel
                   </button>
                   <button 
                     type="submit" 
                     disabled={isSubmitting}
                     className="relative overflow-hidden px-6 py-2.5 rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 transition-all disabled:opacity-70 flex items-center gap-2 group shadow-[0_0_15px_rgba(37,99,235,0.4)] hover:shadow-[0_0_25px_rgba(37,99,235,0.6)]"
                   >
                     {isSubmitting ? (
                       <>
                         <Database className="animate-spin" size={16} />
                         Synchronizing...
                       </>
                     ) : (
                       <>
                         <Save size={16} className="group-hover:scale-110 transition-transform" />
                         Commit to DB
                       </>
                     )}
                   </button>
                 </div>
               </div>

             </div>
           </div>
         </form>
       )}
     </div>
   </div>
 );
}